{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' https://7773333123.github.io; font-src 'self'; media-src 'self' https:; frame-src https://www.youtube-nocookie.com https://www.instagram.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/agora\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=15, must-revalidate"
        }
      ]
    },
    {
      "source": "/(feed|feed-recente|feed_links)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/anos/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(assets/fonts|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/pagina.js": {
      "memory": 1024,
      "maxDuration": 20
    },
    "api/sitemap.js": {
      "maxDuration": 20,
      "memory": 1024
    },
    "api/materia.js": {
      "memory": 1024,
      "maxDuration": 20
    },
    "api/foto.js": {
      "memory": 1024,
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/observatorio",
      "destination": "/observatorio.html"
    },
    {
      "source": "/noticia/:caminho",
      "destination": "/api/pagina?tipo=noticia&id=:caminho&caminho=:caminho"
    },
    {
      "source": "/estado/:uf",
      "destination": "/api/pagina?tipo=estado&id=:uf"
    },
    {
      "source": "/cidade/:uf/:cidade",
      "destination": "/api/pagina?tipo=cidade&id=:uf&cidade=:cidade"
    },
    {
      "source": "/categoria/:tipo",
      "destination": "/api/pagina?tipo=categoria&id=:tipo"
    },
    {
      "source": "/relatorios",
      "destination": "/api/pagina?tipo=relatorios"
    },
    {
      "source": "/relatorio/:mes",
      "destination": "/api/pagina?tipo=relatorio&id=:mes"
    },
    {
      "source": "/(sobre|termos|privacidade|remocao)",
      "destination": "/api/pagina?tipo=institucional&id=$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-noticias.xml",
      "destination": "/api/sitemap?tipo=noticias"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/bloqueado).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*[Bb][Yy][Tt][Ee][Ss][Pp][Ii][Dd][Ee][Rr].*"
        }
      ],
      "destination": "/api/bloqueado",
      "permanent": false
    },
    {
      "source": "/dados",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dados.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dados/:caminho*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/observatorio.html",
      "destination": "/observatorio",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "buildCommand": "node --max-old-space-size=6144 scripts/baixar-dados.js",
  "outputDirectory": "public",
  "ignoreCommand": "node scripts/vercel-ignorar.js",
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  }
}
